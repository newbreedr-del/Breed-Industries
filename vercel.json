{
  "functions": {
    "app/api/**/*.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/scrape-tenders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scrape-tenders?mode=digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/commitment-followups",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/campaign-drip",
      "schedule": "*/15 9-17 * * 1-5"
    }
  ]
}
